<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 560" width="400" height="560">
  <defs>
    <linearGradient id="bookCoverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D2240" />
      <stop offset="50%" stop-color="#1A237E" />
      <stop offset="100%" stop-color="#8D153A" />
    </linearGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFD600" />
      <stop offset="100%" stop-color="#FFBE29" />
    </linearGradient>
  </defs>

  <!-- Book Cover Background -->
  <rect width="400" height="560" rx="12" fill="url(#bookCoverGrad)" />
  <rect x="8" y="8" width="384" height="544" rx="8" fill="none" stroke="url(#goldAccent)" stroke-width="2" stroke-opacity="0.6" />
  
  <!-- Spine Shadow -->
  <rect x="0" y="0" width="24" height="560" rx="4" fill="#000000" fill-opacity="0.25" />
  <line x1="24" y1="0" x2="24" y2="560" stroke="#FFD600" stroke-width="1" stroke-opacity="0.4" />

  <!-- Publisher Emblem -->
  <circle cx="200" cy="140" r="48" fill="#0D2240" stroke="url(#goldAccent)" stroke-width="3" />
  <path d="M185 155 L200 125 L215 155 Z" fill="#FFD600" />
  <circle cx="200" cy="138" r="8" fill="#D32F2F" />

  <!-- Publisher Brand Typography -->
  <text x="200" y="230" text-anchor="middle" font-family="'Noto Sans Sinhala', 'Inter', sans-serif" font-weight="800" font-size="28" fill="#FFD600" letter-spacing="1">
    පදනම ප්‍රකාශන
  </text>
  <text x="200" y="258" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="600" font-size="14" fill="#FFF8EC" opacity="0.9" letter-spacing="3">
    PADANAMA PUBLICATIONS
  </text>

  <!-- Decorative Divider -->
  <line x1="120" y1="280" x2="280" y2="280" stroke="url(#goldAccent)" stroke-width="2" stroke-linecap="round" />
  <polygon points="200,276 205,280 200,284 195,280" fill="#FFD600" />

  <!-- Book Mock Title / Placeholder Label -->
  <text x="200" y="340" text-anchor="middle" font-family="'Noto Sans Sinhala', 'Inter', sans-serif" font-weight="700" font-size="20" fill="#FFFFFF">
    නිල ග්‍රන්ථ නාමාවලිය
  </text>
  <text x="200" y="370" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="500" font-size="13" fill="#FFF8EC" opacity="0.75">
    Official Edition
  </text>

  <!-- Bottom Verification Badge -->
  <rect x="60" y="470" width="280" height="40" rx="8" fill="#0D2240" fill-opacity="0.8" stroke="#FFD600" stroke-width="1" stroke-dasharray="4 2" />
  <text x="200" y="495" text-anchor="middle" font-family="'Noto Sans Sinhala', 'Inter', sans-serif" font-weight="600" font-size="12" fill="#FFD600">
    ✓ 100% තත්ත්ව සහතික කළ මුද්‍රණය
  </text>
</svg>
