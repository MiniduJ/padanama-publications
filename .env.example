# ==========================================
# Padanama Publications — Environment Configuration
# ==========================================

# Node & Application Runtime
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="si"

# Database Connection (PostgreSQL)
# Local Docker or Neon / Supabase Connection String
DATABASE_URL="postgresql://padanama:padanama_dev_password@localhost:5432/padanama_db?schema=public"

# Authentication & Sessions (NextAuth / Auth.js)
AUTH_SECRET="generate-a-secure-32-byte-hex-or-base64-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional for local dev)
AUTH_GOOGLE_ID="google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="google-client-secret"

# PayHere Payment Gateway (Sri Lanka)
# Sandbox mode toggled via PAYHERE_MODE=sandbox
PAYHERE_MODE="sandbox"
PAYHERE_MERCHANT_ID="1211111"
PAYHERE_MERCHANT_SECRET="payhere-sample-merchant-secret-sandbox"
PAYHERE_NOTIFY_URL="http://localhost:3000/api/webhooks/payhere"

# WebXPay Gateway (Secondary Adapter)
WEBXPAY_PUBLIC_KEY="webxpay-public-key"
WEBXPAY_SECRET_KEY="webxpay-secret-key"

# Koko BNPL Gateway (Sri Lanka)
KOKO_MERCHANT_ID="koko-merchant-id"
KOKO_API_KEY="koko-api-key"

# SMS Lenz Gateway (Sri Lanka — +94 OTP & Order Tracking)
# Provider: smslenz.lk
SMSLENZ_API_KEY="sample-smslenz-api-key"
SMSLENZ_SENDER_ID="Padanama"

# Object Storage (Cloudflare R2 / AWS S3 Compatible)
# Private buckets for digital books and public bucket for covers
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_PUBLIC_BUCKET_NAME="padanama-public"
R2_PUBLIC_DOMAIN="https://assets.padanamapublication.lk"
R2_PRIVATE_BUCKET_NAME="padanama-private"

# Email Delivery (Resend / AWS SES)
RESEND_API_KEY="re_sample_api_key"
EMAIL_FROM="Padanama Publications <orders@padanamapublication.lk>"

# Observability & Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
