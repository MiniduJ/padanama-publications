{
  "hosting": {
    "public": "public_html",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/en",
        "destination": "/en.html"
      },
      {
        "source": "/si",
        "destination": "/si.html"
      },
      {
        "source": "/ta",
        "destination": "/ta.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
